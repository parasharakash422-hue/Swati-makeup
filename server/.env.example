# Copy this file to .env and fill in the values.

PORT=5000

# Secret used to view enquiries at /admin. Pick a long random phrase.
ADMIN_KEY=change-this-to-a-long-secret

# Email notifications for new enquiries (optional but recommended).
#
# Option 1 - Resend (use this on Render's free plan, which blocks Gmail/SMTP).
# Sign up at https://resend.com with the same address as NOTIFY_EMAIL,
# create an API key, and paste it here. If this is set, it is used first.
RESEND_API_KEY=
#
# Option 2 - Gmail (works on your own computer and on paid hosts).
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=parasharakash422@gmail.com
SMTP_PASS=
NOTIFY_EMAIL=parasharakash422@gmail.com

# Only needed if the React site is hosted on a different domain than the API,
# e.g. https://swatisharma.in
CORS_ORIGIN=
